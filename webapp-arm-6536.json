{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "westus2"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-03-01",
      "name": "armAppServicePlan6536",
      "location": "[parameters('location')]",
      "sku": {
        "name": "B1",
        "capacity": 1
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-03-01",
      "name": "armWebApp6536",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "dependsOn": [
        "Microsoft.Web/serverfarms/armAppServicePlan6536"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', 'armAppServicePlan6536')]",
        "siteConfig": {
          "linuxFxVersion": "PYTHON|3.10"
        }
      }
    }
  ]
}
